# Custom trip form — email delivery (choose Resend OR SendGrid)
# Copy this file to .env.local and fill in your values.

# --- Option A: Resend (recommended, simple setup) ---
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Who receives the form submissions (your business email)
NEXT_PUBLIC_TO_EMAIL=you@yourdomain.com
# Or use these instead (server-only, not exposed to client):
# CUSTOM_TRIP_TO_EMAIL=you@yourdomain.com

# "From" address for outgoing emails (must be a verified domain in Resend, or use onboarding@resend.dev for testing)
NEXT_PUBLIC_FROM_EMAIL=Island Adventures <noreply@yourdomain.com>
# Or: CUSTOM_TRIP_FROM_EMAIL=noreply@yourdomain.com

# --- Option B: SendGrid ---
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# NEXT_PUBLIC_FROM_EMAIL=...
# NEXT_PUBLIC_TO_EMAIL=...
